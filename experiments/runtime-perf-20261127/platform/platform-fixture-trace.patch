 local host,deckRoots,serial
+local function bump(name)
+    counts.nativeCalls=counts.nativeCalls+1
+    counts.methods[name]=(counts.methods[name] or 0)+1
+end
+local function resident(root)
+    local seen={}
+    local total,alive,visible=0,0,0
+    local function walk(control,show)
+        if seen[control] then return end
+        seen[control]=true
+        total=total+1
+        local live=control.alive~=false
+        if live then alive=alive+1 end
+        show=show and live and control.activeInHierarchy and control.visible~=false
+        if show then visible=visible+1 end
+        for _,node in pairs(control.children or {}) do walk(node,show) end
+        for _,node in pairs(control.items or {}) do walk(node,show) end
+    end
+    walk(root,true)
+    return total,alive,visible
+end
+local oldMark=mark
+local function mark(phase)
+    oldMark(phase)
+    print('PLATFORM_RESIDENT '..phase..' '..table.concat({resident(script.object)},' '))
+end
